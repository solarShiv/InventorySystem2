model useritemstock {
  id            String                  @id
  empId         String?
  rawMaterialId String?
  quantity      Float                   @default(0)
  unit          String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime
  itemId        String?
  itemType      useritemstock_itemType?
  user          user?                   @relation(fields: [empId], references: [id], map: "UserItemStock_empId_fkey")
  rawmaterial   rawmaterial?            @relation(fields: [rawMaterialId], references: [id], map: "UserItemStock_rawMaterialId_fkey")

  @@unique([empId, itemId, itemType], map: "UserItemStock_empId_itemId_itemType_key")
  @@unique([empId, rawMaterialId], map: "UserItemStock_empId_rawMaterialId_key")
  @@index([rawMaterialId], map: "UserItemStock_rawMaterialId_fkey")
}

model vendor {
  id                String             @id
  name              String
  email             String?
  gstNumber         String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  country           String?            @default("INDIA")
  currency          String?            @default("INR")
  contactNumber     String?
  alternateNumber   String?
  createdBy         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  exchangeRate      Decimal?
  isActive          Boolean?           @default(true)
  contactPerson     String?
  accountHolder     String?
  accountNumber     String?
  bankName          String?
  ifscCode          String?
  vendorAadhaar     String?
  vendorPanCard     String?
  aadhaarUrl        String?
  pancardUrl        String?
  contactNoVerified Boolean?           @default(false)
  mailVerified      Boolean?           @default(false)
  zipCode           String?
  referenceBy       String?
  bankdetail        bankdetail[]
  debitnote         debitnote[]
  prepo             prepo[]
  purchasefollowup  purchasefollowup[]
  purchaseorder     purchaseorder[]
  returntovendor    returntovendor[]
  user              user               @relation(fields: [createdBy], references: [id], map: "Vendor_createdBy_fkey")
  vendorinvoices    vendorinvoices[]

  @@index([createdBy], map: "Vendor_createdBy_fkey")
}

model vendorinvoices {
  id                                  String         @id
  vendorId                            String
  poId                                String?
  invoiceUrl                          String?
  createdAt                           DateTime       @default(now())
  updatedAt                           DateTime
  createdBy                           String?
  updatedBy                           String?
  invoiceNumber                       String?
  user_vendorinvoices_createdByTouser user?          @relation("vendorinvoices_createdByTouser", fields: [createdBy], references: [id], map: "VendorInvoices_createdBy_fkey")
  purchaseorder                       purchaseorder? @relation(fields: [poId], references: [id], map: "VendorInvoices_poId_fkey")
  user_vendorinvoices_updatedByTouser user?          @relation("vendorinvoices_updatedByTouser", fields: [updatedBy], references: [id], map: "VendorInvoices_updatedBy_fkey")
  vendor                              vendor         @relation(fields: [vendorId], references: [id], map: "VendorInvoices_vendorId_fkey")

  @@unique([vendorId, poId, invoiceNumber], map: "VendorInvoices_vendorId_poId_invoiceNumber_key")
  @@index([createdBy], map: "VendorInvoices_createdBy_fkey")
  @@index([poId], map: "VendorInvoices_poId_fkey")
  @@index([updatedBy], map: "VendorInvoices_updatedBy_fkey")
}

model warehouse {
  id        String   @id
  name      String?  @unique(map: "Warehouse_name_key")
  state     String?
  createdAt DateTime @default(now())
}

model warehousestock {
  id              String                   @id
  warehouseId     String?
  rawMaterialId   String?
  quantity        Float?                   @default(0)
  unit            String?
  isUsed          Boolean?                 @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime
  damagedQty      Float?                   @default(0)
  infraItemId     String?
  itemType        warehousestock_itemType?
  toolEquipmentId String?
  itemId          String?
  inframaterial   inframaterial?           @relation(fields: [infraItemId], references: [id], map: "WarehouseStock_infraItemId_fkey")
  rawmaterial     rawmaterial?             @relation(fields: [rawMaterialId], references: [id], map: "WarehouseStock_rawMaterialId_fkey")
  toolsequipments toolsequipments?         @relation(fields: [toolEquipmentId], references: [id], map: "WarehouseStock_toolEquipmentId_fkey")

  @@unique([warehouseId, infraItemId], map: "WarehouseStock_warehouseId_infraItemId_key")
  @@unique([warehouseId, rawMaterialId], map: "WarehouseStock_warehouseId_rawMaterialId_key")
  @@unique([warehouseId, toolEquipmentId], map: "WarehouseStock_warehouseId_toolEquipmentId_key")
  @@index([infraItemId], map: "WarehouseStock_infraItemId_fkey")
  @@index([rawMaterialId], map: "WarehouseStock_rawMaterialId_fkey")
  @@index([toolEquipmentId], map: "WarehouseStock_toolEquipmentId_fkey")
  @@index([warehouseId], map: "WarehouseStock_warehouseId_idx")
}

