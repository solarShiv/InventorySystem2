generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auditlog {
  id          String   @id
  entityType  String
  entityId    String
  action      String
  performedBy String?
  oldValue    Json?
  newValue    Json?
  timestamp   DateTime @default(now())
}

model bankdetail {
  id            String          @id
  accountHolder String
  bankName      String
  branchName    String?
  accountNumber String
  ifscCode      String
  accountType   String?         @default("Current")
  isPrimary     Boolean         @default(false)
  vendorId      String?
  companyId     String?
  createdBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  company       company?        @relation(fields: [companyId], references: [id], map: "BankDetail_companyId_fkey")
  user          user?           @relation(fields: [createdBy], references: [id], map: "BankDetail_createdBy_fkey")
  vendor        vendor?         @relation(fields: [vendorId], references: [id], map: "BankDetail_vendorId_fkey")
  debitnote     debitnote[]
  purchaseorder purchaseorder[]

  @@index([companyId], map: "BankDetail_companyId_fkey")
  @@index([createdBy], map: "BankDetail_createdBy_fkey")
  @@index([vendorId], map: "BankDetail_vendorId_fkey")
}

model bomentry {
  id            String  @id
  itemId        String?
  rawMaterialId String?
  quantity      Float?
}

model company {
  id              String          @id
  name            String
  companyCode     String?
  gstNumber       String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  contactNumber   String?
  alternateNumber String?
  email           String?
  country         String?         @default("INDIA")
  currency        String?         @default("INR")
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  isActive        Boolean?        @default(true)
  accountHolder   String?
  accountNumber   String?
  bankName        String?
  companyAadhaar  String?
  companyPanCard  String?
  ifscCode        String?
  bankdetail      bankdetail[]
  user            user            @relation(fields: [createdBy], references: [id], map: "Company_createdBy_fkey")
  debitnote       debitnote[]
  purchaseorder   purchaseorder[]

  @@index([createdBy], map: "Company_createdBy_fkey")
}

model counter {
  id            String   @id
  name          String   @unique(map: "Counter_name_key")
  companyId     String?
  financialYear String?
  seq           Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model damagedstock {
  id                                String              @id
  purchaseOrderId                   String?
  itemId                            String?
  itemSource                        String?
  itemName                          String?
  quantity                          Decimal             @db.Decimal(12, 4)
  remarks                           String?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime
  createdBy                         String?
  debitNoteId                       String?
  invoiceNumber                     String?
  status                            damagedstock_status @default(Pending)
  amountInForeign                   Decimal?            @db.Decimal(12, 4)
  gstRate                           Decimal?            @db.Decimal(7, 4)
  hsnCode                           String?
  itemDetail                        String?             @db.Text
  itemGSTType                       String?
  modelNumber                       String?
  rate                              Decimal?            @db.Decimal(12, 4)
  rateInForeign                     Decimal?            @db.Decimal(12, 4)
  receivedQty                       Decimal?            @default(0.0000) @db.Decimal(12, 4)
  total                             Decimal?            @db.Decimal(12, 4)
  unit                              String?
  updatedBy                         String?
  user_damagedstock_createdByTouser user?               @relation("damagedstock_createdByTouser", fields: [createdBy], references: [id], map: "DamagedStock_createdBy_fkey")
  debitnote                         debitnote?          @relation(fields: [debitNoteId], references: [id], map: "DamagedStock_debitNoteId_fkey")
  purchaseorder                     purchaseorder?      @relation(fields: [purchaseOrderId], references: [id], map: "DamagedStock_purchaseOrderId_fkey")
  user_damagedstock_updatedByTouser user?               @relation("damagedstock_updatedByTouser", fields: [updatedBy], references: [id], map: "DamagedStock_updatedBy_fkey")

  @@index([createdBy], map: "DamagedStock_createdBy_fkey")
  @@index([debitNoteId], map: "DamagedStock_debitNoteId_fkey")
  @@index([purchaseOrderId], map: "DamagedStock_purchaseOrderId_fkey")
  @@index([updatedBy], map: "DamagedStock_updatedBy_fkey")
}

model debitnote {
  id                      String                    @id
  debitNoteNo             String                    @unique(map: "DebitNote_debitNoteNo_key")
  financialYear           String?
  purchaseOrderId         String?
  companyId               String
  companyName             String?
  vendorId                String
  vendorName              String?
  bankDetailId            String?
  createdBy               String?
  drNoteDate              DateTime                  @default(now())
  gstType                 debitnote_gstType
  gstRate                 Decimal?                  @db.Decimal(7, 4)
  currency                String?                   @default("INR")
  exchangeRate            Decimal?                  @default(1.0000) @db.Decimal(12, 4)
  foreignSubTotal         Decimal?                  @db.Decimal(12, 4)
  foreignGrandTotal       Decimal?                  @db.Decimal(12, 4)
  subTotal                Decimal?                  @db.Decimal(12, 4)
  totalCGST               Decimal?                  @db.Decimal(12, 4)
  totalSGST               Decimal?                  @db.Decimal(12, 4)
  totalIGST               Decimal?                  @db.Decimal(12, 4)
  totalGST                Decimal?                  @db.Decimal(12, 4)
  grandTotal              Decimal?                  @db.Decimal(12, 4)
  status                  debitnote_status          @default(Debited)
  remarks                 String?
  pdfUrl                  String?
  pdfName                 String?
  pdfGeneratedAt          DateTime?
  pdfGeneratedBy          String?
  orgInvoiceNo            String?
  orgInvoiceDate          DateTime?
  gr_rr_no                String?
  transport               String?
  vehicleNumber           String?
  station                 String?
  otherCharges            Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  billReference           String?
  approvalStatus          debitnote_approvalStatus  @default(Pending)
  approvedAt              DateTime?
  approvedBy              String?
  rejectionReason         String?
  warehouseId             String?
  warehouseName           String?
  fixedGrandTotal         Decimal?                  @db.Decimal(12, 4)
  expectedDeliveryDate    DateTime?
  damagedstock            damagedstock[]
  bankdetail              bankdetail?               @relation(fields: [bankDetailId], references: [id], map: "DebitNote_bankDetailId_fkey")
  company                 company                   @relation(fields: [companyId], references: [id], map: "DebitNote_companyId_fkey")
  user                    user?                     @relation(fields: [createdBy], references: [id], map: "DebitNote_createdBy_fkey")
  vendor                  vendor                    @relation(fields: [vendorId], references: [id], map: "DebitNote_vendorId_fkey")
  debitnotebill           debitnotebill[]
  payment                 payment[]
  purchaseordebitnoteterm purchaseordebitnoteterm[]
  purchaseorderitem       purchaseorderitem[]
  purchaseorderreceipt    purchaseorderreceipt[]
  returntovendor          returntovendor[]

  @@index([bankDetailId], map: "DebitNote_bankDetailId_fkey")
  @@index([companyId], map: "DebitNote_companyId_fkey")
  @@index([createdBy], map: "DebitNote_createdBy_fkey")
  @@index([vendorId], map: "DebitNote_vendorId_fkey")
}

model debitnotebill {
  id            String    @id
  debitNoteId   String
  invoiceNumber String?
  fileName      String
  fileUrl       String
  mimeType      String
  uploadedBy    String
  createdAt     DateTime  @default(now())
  debitnote     debitnote @relation(fields: [debitNoteId], references: [id], map: "DebitNoteBill_debitNoteId_fkey")

  @@index([debitNoteId], map: "DebitNoteBill_debitNoteId_fkey")
}

model directitemissue {
  id                                   String                  @id
  warehouseId                          String?
  serviceProcessId                     String?
  isProcessIssue                       Boolean                 @default(false)
  rawMaterialIssued                    Json?
  issuedTo                             String?
  issuedBy                             String?
  issuedAt                             DateTime                @default(now())
  remarks                              String?
  updatedAt                            DateTime?
  updatedBy                            String?
  department                           String?
  issuedToName                         String?
  materialIssued                       Json?
  proofImage                           Json?
  user_directitemissue_issuedByTouser  user?                   @relation("directitemissue_issuedByTouser", fields: [issuedBy], references: [id], map: "DirectItemIssue_issuedBy_fkey")
  user_directitemissue_issuedToTouser  user?                   @relation("directitemissue_issuedToTouser", fields: [issuedTo], references: [id], map: "DirectItemIssue_issuedTo_fkey")
  service_process_record               service_process_record? @relation(fields: [serviceProcessId], references: [id], map: "DirectItemIssue_serviceProcessId_fkey")
  user_directitemissue_updatedByTouser user?                   @relation("directitemissue_updatedByTouser", fields: [updatedBy], references: [id], map: "DirectItemIssue_updatedBy_fkey")

  @@index([issuedBy], map: "DirectItemIssue_issuedBy_fkey")
  @@index([issuedTo], map: "DirectItemIssue_issuedTo_fkey")
  @@index([serviceProcessId], map: "DirectItemIssue_serviceProcessId_fkey")
  @@index([updatedBy], map: "DirectItemIssue_updatedBy_fkey")
}

model disassemble_reusable_items {
  id                                                  String                 @id
  serviceProcessId                                    String
  empId                                               String?
  assembleEmpId                                       String?
  reusableItems                                       Json?
  remarks                                             String?
  createdAt                                           DateTime               @default(now())
  user_disassemble_reusable_items_assembleEmpIdTouser user?                  @relation("disassemble_reusable_items_assembleEmpIdTouser", fields: [assembleEmpId], references: [id], map: "Disassemble_Reusable_Items_assembleEmpId_fkey")
  user_disassemble_reusable_items_empIdTouser         user?                  @relation("disassemble_reusable_items_empIdTouser", fields: [empId], references: [id], map: "Disassemble_Reusable_Items_empId_fkey")
  service_process_record                              service_process_record @relation(fields: [serviceProcessId], references: [id], map: "Disassemble_Reusable_Items_serviceProcessId_fkey")

  @@index([assembleEmpId], map: "Disassemble_Reusable_Items_assembleEmpId_fkey")
  @@index([empId], map: "Disassemble_Reusable_Items_empId_fkey")
  @@index([serviceProcessId], map: "Disassemble_Reusable_Items_serviceProcessId_fkey")
}

model failureredirect {
  id              String                        @id
  itemTypeId      String?
  failureReason   failureredirect_failureReason
  redirectStageId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime
  productId       String?
  itemtype        itemtype?                     @relation(fields: [itemTypeId], references: [id], map: "FailureRedirect_itemTypeId_fkey")
  product         product?                      @relation(fields: [productId], references: [id], map: "FailureRedirect_productId_fkey")
  stage           stage?                        @relation(fields: [redirectStageId], references: [id], map: "FailureRedirect_redirectStageId_fkey")

  @@index([itemTypeId], map: "FailureRedirect_itemTypeId_fkey")
  @@index([productId], map: "FailureRedirect_productId_fkey")
  @@index([redirectStageId], map: "FailureRedirect_redirectStageId_fkey")
}

model inframaterial {
  id                                 String           @id
  name                               String?          @unique(map: "InfraMaterial_name_key")
  unit                               String?
  hsnCode                            String?
  conversionUnit                     String?
  conversionFactor                   Float?
  isUsed                             Boolean?         @default(true)
  description                        String?
  createdAt                          DateTime         @default(now())
  createdBy                          String?
  updatedAt                          DateTime
  updatedBy                          String?
  user_inframaterial_createdByTouser user?            @relation("inframaterial_createdByTouser", fields: [createdBy], references: [id], map: "InfraMaterial_createdBy_fkey")
  user_inframaterial_updatedByTouser user?            @relation("inframaterial_updatedByTouser", fields: [updatedBy], references: [id], map: "InfraMaterial_updatedBy_fkey")
  stockmovement                      stockmovement[]
  warehousestock                     warehousestock[]

  @@index([createdBy], map: "InfraMaterial_createdBy_fkey")
  @@index([updatedBy], map: "InfraMaterial_updatedBy_fkey")
}

model item {
  id                 String               @id
  name               String?              @unique(map: "Item_name_key")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  itemrawmaterial    itemrawmaterial[]
  manufacturingusage manufacturingusage[]
  product_item_map   product_item_map[]
  productionlog      productionlog[]
}

model item_model {
  id              String            @id
  model           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  itemrawmaterial itemrawmaterial[]
}

model itemrawmaterial {
  id            String       @id
  itemId        String?
  rawMaterialId String?
  quantity      Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  updatedBy     String?
  itemModelId   String?
  item          item?        @relation(fields: [itemId], references: [id], map: "ItemRawMaterial_itemId_fkey")
  item_model    item_model?  @relation(fields: [itemModelId], references: [id], map: "ItemRawMaterial_itemModelId_fkey")
  rawmaterial   rawmaterial? @relation(fields: [rawMaterialId], references: [id], map: "ItemRawMaterial_rawMaterialId_fkey")
  user          user?        @relation(fields: [updatedBy], references: [id], map: "ItemRawMaterial_updatedBy_fkey")

  @@unique([itemId, rawMaterialId], map: "ItemRawMaterial_itemId_rawMaterialId_key")
  @@index([itemModelId], map: "ItemRawMaterial_itemModelId_fkey")
  @@index([rawMaterialId], map: "ItemRawMaterial_rawMaterialId_fkey")
  @@index([updatedBy], map: "ItemRawMaterial_updatedBy_fkey")
}

model itemrequestdata {
  id                                     String                  @id
  serviceProcessId                       String?
  isProcessRequest                       Boolean                 @default(false)
  rawMaterialRequested                   Json?
  requestedTo                            String?
  requestedBy                            String?
  requestedAt                            DateTime                @default(now())
  approved                               Boolean?
  approvedBy                             String?
  approvedAt                             DateTime?
  materialGiven                          Boolean?
  updatedAt                              DateTime?
  updatedBy                              String?
  declined                               Boolean?
  declinedAt                             DateTime?
  declinedBy                             String?
  declinedRemarks                        String?
  warehouseId                            String?
  materialRequested                      Json?
  user_itemrequestdata_approvedByTouser  user?                   @relation("itemrequestdata_approvedByTouser", fields: [approvedBy], references: [id], map: "ItemRequestData_approvedBy_fkey")
  user_itemrequestdata_declinedByTouser  user?                   @relation("itemrequestdata_declinedByTouser", fields: [declinedBy], references: [id], map: "ItemRequestData_declinedBy_fkey")
  user_itemrequestdata_requestedByTouser user?                   @relation("itemrequestdata_requestedByTouser", fields: [requestedBy], references: [id], map: "ItemRequestData_requestedBy_fkey")
  service_process_record                 service_process_record? @relation(fields: [serviceProcessId], references: [id], map: "ItemRequestData_serviceProcessId_fkey")
  user_itemrequestdata_updatedByTouser   user?                   @relation("itemrequestdata_updatedByTouser", fields: [updatedBy], references: [id], map: "ItemRequestData_updatedBy_fkey")

  @@index([approvedBy], map: "ItemRequestData_approvedBy_fkey")
  @@index([declinedBy], map: "ItemRequestData_declinedBy_fkey")
  @@index([requestedBy], map: "ItemRequestData_requestedBy_fkey")
  @@index([serviceProcessId], map: "ItemRequestData_serviceProcessId_fkey")
  @@index([updatedBy], map: "ItemRequestData_updatedBy_fkey")
}

model itemtype {
  id                     String                   @id
  name                   String                   @unique(map: "ItemType_name_key")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  failureredirect        failureredirect[]
  itemtype_stage         itemtype_stage[]
  service_process_record service_process_record[]
  stageflow              stageflow[]
}

model itemtype_stage {
  id         String    @id
  itemTypeId String?
  stageId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  itemtype   itemtype? @relation(fields: [itemTypeId], references: [id], map: "ItemType_Stage_itemTypeId_fkey")
  stage      stage?    @relation(fields: [stageId], references: [id], map: "ItemType_Stage_stageId_fkey")

  @@index([itemTypeId], map: "ItemType_Stage_itemTypeId_fkey")
  @@index([stageId], map: "ItemType_Stage_stageId_fkey")
}

model itemusage {
  id                     String                  @id
  serviceProcessId       String?
  empId                  String?
  rawMaterialId          String?
  quantityUsed           Float?
  unit                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  itemId                 String?
  itemType               itemusage_itemType?
  user                   user?                   @relation(fields: [empId], references: [id], map: "ItemUsage_empId_fkey")
  rawmaterial            rawmaterial?            @relation(fields: [rawMaterialId], references: [id], map: "ItemUsage_rawMaterialId_fkey")
  service_process_record service_process_record? @relation(fields: [serviceProcessId], references: [id], map: "ItemUsage_serviceProcessId_fkey")

  @@index([empId], map: "ItemUsage_empId_fkey")
  @@index([rawMaterialId], map: "ItemUsage_rawMaterialId_fkey")
  @@index([serviceProcessId], map: "ItemUsage_serviceProcessId_fkey")
}

model manufacturingusage {
  id                String       @id
  itemId            String?
  rawMaterialId     String?
  quantityUsed      Float?
  unit              String?
  manufacturingDate DateTime     @default(now())
  item              item?        @relation(fields: [itemId], references: [id], map: "ManufacturingUsage_itemId_fkey")
  rawmaterial       rawmaterial? @relation(fields: [rawMaterialId], references: [id], map: "ManufacturingUsage_rawMaterialId_fkey")

  @@index([itemId], map: "ManufacturingUsage_itemId_fkey")
  @@index([rawMaterialId], map: "ManufacturingUsage_rawMaterialId_fkey")
}

model materialreturn {
  id                                   String       @id
  empId                                String?
  rawMaterialId                        String?
  installationItemId                   String?
  returnedQty                          Float
  unit                                 String?
  warehouseId                          String?
  returnedBy                           String?
  remarks                              String?
  returnedAt                           DateTime     @default(now())
  user_materialreturn_empIdTouser      user?        @relation("materialreturn_empIdTouser", fields: [empId], references: [id], map: "MaterialReturn_empId_fkey")
  rawmaterial                          rawmaterial? @relation(fields: [rawMaterialId], references: [id], map: "MaterialReturn_rawMaterialId_fkey")
  user_materialreturn_returnedByTouser user?        @relation("materialreturn_returnedByTouser", fields: [returnedBy], references: [id], map: "MaterialReturn_returnedBy_fkey")

  @@index([empId], map: "MaterialReturn_empId_idx")
  @@index([rawMaterialId], map: "MaterialReturn_rawMaterialId_idx")
  @@index([returnedBy], map: "MaterialReturn_returnedBy_idx")
}

model panelmaster {
  id         String   @id
  panelType  String?
  moduleType String?
  dcrType    String?
  wattage    String?
  hsnCode    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model payment {
  id                                      String                   @id
  poId                                    String
  paymentDate                             DateTime?
  amount                                  Decimal                  @db.Decimal(12, 4)
  createdAt                               DateTime?                @default(now())
  debitNoteId                             String?
  adminApprovalDate                       DateTime?
  adminApprovalStatus                     Boolean?
  adminRemark                             String?
  approvedByAdmin                         String?
  billpaymentType                         payment_billpaymentType?
  createdBy                               String?
  docApprovalDate                         DateTime?
  docApprovalRemark                       String?
  docApprovalStatus                       Boolean?
  docApprovedBy                           String?
  paymentRemark                           String?
  paymentRequestedBy                      String?
  paymentStatus                           Boolean?
  paymentTransferredBy                    String?
  updatedAt                               DateTime?
  updatedBy                               String?
  paymentRejected                         Boolean?                 @default(false)
  paymentRejectedAt                       DateTime?
  paymentRejectedBy                       String?
  user_payment_approvedByAdminTouser      user?                    @relation("payment_approvedByAdminTouser", fields: [approvedByAdmin], references: [id], map: "Payment_approvedByAdmin_fkey")
  user_payment_createdByTouser            user?                    @relation("payment_createdByTouser", fields: [createdBy], references: [id], map: "Payment_createdBy_fkey")
  debitnote                               debitnote?               @relation(fields: [debitNoteId], references: [id], map: "Payment_debitNoteId_fkey")
  user_payment_docApprovedByTouser        user?                    @relation("payment_docApprovedByTouser", fields: [docApprovedBy], references: [id], map: "Payment_docApprovedBy_fkey")
  user_payment_paymentRejectedByTouser    user?                    @relation("payment_paymentRejectedByTouser", fields: [paymentRejectedBy], references: [id], map: "Payment_paymentRejectedBy_fkey")
  user_payment_paymentRequestedByTouser   user?                    @relation("payment_paymentRequestedByTouser", fields: [paymentRequestedBy], references: [id], map: "Payment_paymentRequestedBy_fkey")
  user_payment_paymentTransferredByTouser user?                    @relation("payment_paymentTransferredByTouser", fields: [paymentTransferredBy], references: [id], map: "Payment_paymentTransferredBy_fkey")
  purchaseorder                           purchaseorder            @relation(fields: [poId], references: [id], map: "Payment_poId_fkey")

  @@index([approvedByAdmin], map: "Payment_approvedByAdmin_fkey")
  @@index([createdBy], map: "Payment_createdBy_idx")
  @@index([debitNoteId], map: "Payment_debitNoteId_fkey")
  @@index([docApprovedBy], map: "Payment_docApprovedBy_fkey")
  @@index([paymentRejectedBy], map: "Payment_paymentRejectedBy_fkey")
  @@index([paymentRequestedBy], map: "Payment_paymentRequestedBy_fkey")
  @@index([paymentTransferredBy], map: "Payment_paymentTransferredBy_fkey")
  @@index([poId], map: "Payment_poId_fkey")
}

model prepo {
  id                         String         @id
  poId                       String?
  vendorId                   String?
  status                     prepo_status   @default(PREPO_DRAFT)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime?
  createdBy                  String?
  updatedBy                  String?
  poNumber                   String?
  user_prepo_createdByTouser user?          @relation("prepo_createdByTouser", fields: [createdBy], references: [id], map: "PrePo_createdBy_fkey")
  purchaseorder              purchaseorder? @relation(fields: [poId], references: [id], map: "PrePo_poId_fkey")
  user_prepo_updatedByTouser user?          @relation("prepo_updatedByTouser", fields: [updatedBy], references: [id], map: "PrePo_updatedBy_fkey")
  vendor                     vendor?        @relation(fields: [vendorId], references: [id], map: "PrePo_vendorId_fkey")
  prepoitems                 prepoitems[]

  @@index([createdBy], map: "PrePo_createdBy_fkey")
  @@index([poId], map: "PrePo_poId_fkey")
  @@index([updatedBy], map: "PrePo_updatedBy_fkey")
  @@index([vendorId], map: "PrePo_vendorId_fkey")
}

model prepoitems {
  id         String    @id
  prePoId    String
  itemId     String?
  itemSource String?
  itemName   String?
  quantity   Decimal   @db.Decimal(18, 4)
  unit       String?
  rate       Decimal   @db.Decimal(12, 4)
  updatedAt  DateTime?
  createdAt  DateTime  @default(now())
  prepo      prepo     @relation(fields: [prePoId], references: [id], map: "PrePoItems_prePoId_fkey")

  @@index([prePoId], map: "PrePoItems_prePoId_fkey")
}

model product {
  id               String             @id
  productName      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  failureredirect  failureredirect[]
  product_item_map product_item_map[]
  stageflow        stageflow[]
}

model product_item_map {
  id        String   @id
  productId String?
  itemId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  item      item?    @relation(fields: [itemId], references: [id], map: "Product_Item_Map_itemId_fkey")
  product   product? @relation(fields: [productId], references: [id], map: "Product_Item_Map_productId_fkey")

  @@unique([productId, itemId], map: "Product_Item_Map_productId_itemId_key")
  @@index([itemId], map: "Product_Item_Map_itemId_fkey")
}

model productionlog {
  id                String   @id
  itemId            String
  subItem           String
  quantityProduced  Int
  manufacturingDate DateTime @default(now())
  userId            String
  item              item     @relation(fields: [itemId], references: [id], map: "ProductionLog_itemId_fkey")
  user              user     @relation(fields: [userId], references: [id], map: "ProductionLog_userId_fkey")

  @@index([itemId], map: "ProductionLog_itemId_fkey")
  @@index([userId], map: "ProductionLog_userId_fkey")
}

model purchasefollowup {
  id                                     String         @id
  purchaseOrderId                        String?
  vendorId                               String?
  expectedDeliveryDate                   DateTime?
  remark                                 String?        @db.Text
  followUpDate                           DateTime       @default(now())
  followUpBy                             String?
  updatedAt                              DateTime
  updatedBy                              String?
  user_purchasefollowup_followUpByTouser user?          @relation("purchasefollowup_followUpByTouser", fields: [followUpBy], references: [id], map: "PurchaseFollowUp_followUpBy_fkey")
  purchaseorder                          purchaseorder? @relation(fields: [purchaseOrderId], references: [id], map: "PurchaseFollowUp_purchaseOrderId_fkey")
